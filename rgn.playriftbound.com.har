            "size": 28183,
            "mimeType": "application/json",
            "text": "{\n    \"app_switcher_2\": {\n        \"cards\": [\n            {\n                \"title\": \"Combattete per crescere in una foresta traboccante di magia selvaggia nel set 18 di TFT.\",\n                \"link\": \"https://teamfighttactics.leagueoflegends.com/it-it/\",\n                \"platform_availability\": [],\n                \"asset\": {\n                    \"url\": \"https://cmsassets.rgpub.io/sanity/images/dsfx7636/riotbar_live/1087a693b969571ccae9adf25d0ca82d3ee9fc69-660x428.png?\",\n                    \"title\": \"\",\n                    \"content_type\": \"image/png\"\n                },\n                \"analytics_id\": \"\"\n            },\n            {\n                \"title\": \"Le migliori squadre si sfidano al Champions di Shanghai. Sintonizzati dal 24 settembre al 18 ottobre. \",\n                \"link\": \"https://valorantesports.com\",\n                \"platform_availability\": [],\n                \"asset\": {\n                    \"url\": \"https://cmsassets.rgpub.io/sanity/images/dsfx7636/riotbar_live/bc18c378a3fa676113037b74c22bf69ae2a5ac5c-660x428.jpg?\",\n                    \"title\": \"\",\n                    \"content_type\": \"image/jpeg\"\n                },\n                \"analytics_id\": \"\"\n            }\n        ],\n        \"links\": [\n            {\n                \"title\": \"GIOCHI\",\n                \"products\": [\n                    {\n                        \"title\": \"LEAGUE OF LEGENDS\",\n                        \"link\": \"https://www.leagueoflegends.com/it-it/\",\n                        \"description\": \"SCONTRATI NEL BATTLE ARENA 5V5 DEFINITIVO\",\n                        \"frame_color\": \"#091428\",\n                        \"mobile_product_card\": true,\n                        \"asset\": {\n                            \"url\": \"https://cmsassets.rgpub.io/sanity/images/dsfx7636/riotbar/9f6c08831b0d22c4c929fc50ada08d29650f1917-1280x721.jpg?\",\n                            \"title\": \"LEAGUE OF LEGENDS\",\n                            \"content_type\": \"image/jpeg\"\n                        },\n                        \"logo\": {\n                            \"url\": \"https://cmsassets.rgpub.io/sanity/images/dsfx7636/riotbar/e003b58a6493371450b6afe73853a9c3ff5149a2-146x55.svg?\",\n                            \"title\": \"\",\n                            \"content_type\": \"image/svg+xml\"\n                        },\n                        \"platform_availability\": [\n                            \"Windows\"\n                        ]\n                    },\n                    {\n                        \"title\": \"VALORANT\",\n                        \"link\": \"https://playvalorant.com/it-it/\",\n                        \"description\": \"MOSTRA IL TUO STILE AI NEMICI IN QUESTO SPARATUTTO TATTICO 5V5\",\n                        \"frame_color\": \"#C5B174\",\n                        \"mobile_product_card\": true,\n                        \"asset\": {\n                            \"url\": \"https://cmsassets.rgpub.io/sanity/images/dsfx7636/riotbar_live/7be02abc58bb852c63bd5ba53ca284d4911210d3-1920x1080.jpg?\",\n                            \"title\": \"VALORANT\",\n                            \"content_type\": \"image/jpeg\"\n                        },\n                        \"logo\": {\n                            \"url\": \"https://cmsassets.rgpub.io/sanity/images/dsfx7636/riotbar/8eea1401b06cc6ab8e0ebef79866326d6169e1f4-146x98.svg?\",\n                            \"title\": \"\",\n                            \"content_type\": \"image/svg+xml\"\n                        },\n                        \"platform_availability\": [\n                            \"Windows\"\n                        ]\n                    },\n                    {\n                        \"title\": \"TEAMFIGHT TACTICS\",\n                        \"link\": \"https://teamfighttactics.leagueoflegends.com/it-it/\",\n                        \"descripti